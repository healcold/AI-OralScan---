ORALSCAN_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ORALSCAN_MAX_UPLOAD_BYTES=26214400
ORALSCAN_UPLOAD_BODY_TIMEOUT_SECONDS=60
ORALSCAN_SQLITE_BUSY_TIMEOUT_SECONDS=10
# ORALSCAN_REPORT_FONT=/absolute/path/to/chinese-font.ttf
# ORALSCAN_DATABASE_URL=sqlite:///./data/oralscan.db
# ORALSCAN_STORAGE_DIR=./data/private
# ORALSCAN_MODELS_DIR=./data/models

# Free local assistant (Ollama). Does not require an API key.
ORALSCAN_ASSISTANT_PROVIDER=ollama
ORALSCAN_ASSISTANT_MAX_CONCURRENT_REQUESTS=2
ORALSCAN_OLLAMA_MODEL=qwen3.5:2b-q4_K_M
ORALSCAN_OLLAMA_TIMEOUT_SECONDS=120

# Optional cloud assistant: set ORALSCAN_ASSISTANT_PROVIDER=deepseek.
# Obtain a key at https://platform.deepseek.com/api_keys and keep it on the backend.
ORALSCAN_DEEPSEEK_API_KEY=
ORALSCAN_DEEPSEEK_MODEL=deepseek-flash
ORALSCAN_DEEPSEEK_TIMEOUT_SECONDS=45
